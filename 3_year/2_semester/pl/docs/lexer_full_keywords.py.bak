import ply.lex as lex

class LexError(Exception):
    pass

reserved = {
    'assign': 'ASSIGN',
    'backspace': 'BACKSPACE',
    'blockdata': 'BLOCKDATA',
    'call': 'CALL',
    'character': 'CHARACTER',
    'close': 'CLOSE',
    'common': 'COMMON',
    'complex': 'COMPLEX',
    'continue': 'CONTINUE',
    'data': 'DATA',
    'dimension': 'DIMENSION',
    'do': 'DO',
    'doubleprecision': 'DOUBLEPRECISION',
    'else': 'ELSE',
    'elseif': 'ELSEIF',
    'end': 'END',
    'endfile': 'ENDFILE',
    'endif': 'ENDIF',
    'entry': 'ENTRY',
    'equivalence': 'EQUIVALENCE',
    'external': 'EXTERNAL',
    'format': 'FORMAT',
    'function': 'FUNCTION',
    'goto': 'GOTO',
    'if': 'IF',
    'implicit': 'IMPLICIT',
    'inquire': 'INQUIRE',
    'integer': 'INTEGER',
    'intrinsic': 'INTRINSIC',
    'logical': 'LOGICAL',
    'open': 'OPEN',
    'parameter': 'PARAMETER',
    'pause': 'PAUSE',
    'print': 'PRINT',
    'program': 'PROGRAM',
    'read': 'READ',
    'real': 'REAL',
    'return': 'RETURN',
    'rewind': 'REWIND',
    'save': 'SAVE',
    'stop': 'STOP',
    'subroutine': 'SUBROUTINE',
    'then': 'THEN',
    'write': 'WRITE'
}

tokens = [
    'IDENTIFIER', 'INTEGER_CONST', 'REAL_CONST', 'DOUBLE_PRECISION_CONST',
    'LOGICAL_CONST', 'CHARACTER_CONST',
    'PLUS', 'MINUS', 'ASTERISK', 'DIVIDE', 'POWER',
    'EQ', 'NE', 'LT', 'LE', 'GT', 'GE',
    'AND', 'OR', 'NOT', 'EQV', 'NEQV',
    'CONCAT',
    'EQUALS', 'COMMA', 'LPAREN', 'RPAREN', 'COLON'
] + list(reserved.values())

def t_COMMENT(t):
    r'(?:^|\n)[Cc][^\n]*|(?:^|\n)[\*!][^\n]*'
    t.lexer.lineno += t.value.count('\n')
    pass

def t_LOGICAL_CONST(t):
    r'\.(?i:TRUE|FALSE)\.'
    return t

def t_CHARACTER_CONST(t):
    r"'(?:[^']|'')*'"
    t.value = t.value[1:-1].replace("''", "'")
    return t

def t_REAL_CONST(t):
    r'(\d+\.\d*|\.\d+)([EeDd][+-]?\d+)?|\d+[EeDd][+-]?\d+'
    if 'D' in t.value.upper():
        t.type = 'DOUBLE_PRECISION_CONST'
    t.value = float(t.value.upper().replace('D', 'E'))
    return t

def t_INTEGER_CONST(t):
    r'\d+'
    t.value = int(t.value)
    return t

def t_IDENTIFIER(t):
    r'[A-Za-z][A-Za-z0-9]*'
    val_lower = t.value.lower()
    t.type = reserved.get(val_lower, 'IDENTIFIER')
    if t.type == 'IDENTIFIER' and len(t.value) > 6:
        print(f"Warning: Identifier '{t.value}' exceeds 6 characters at line {t.lexer.lineno}.")
    return t

t_POWER     = r'\*\*'
t_ASTERISK  = r'\*'
t_CONCAT    = r'//'
t_DIVIDE    = r'/'
t_PLUS      = r'\+'
t_MINUS     = r'-'
t_EQ        = r'\.(?i:EQ)\.'
t_NE        = r'\.(?i:NE)\.'
t_LT        = r'\.(?i:LT)\.'
t_LE        = r'\.(?i:LE)\.'
t_GT        = r'\.(?i:GT)\.'
t_GE        = r'\.(?i:GE)\.'
t_AND       = r'\.(?i:AND)\.'
t_OR        = r'\.(?i:OR)\.'
t_NOT       = r'\.(?i:NOT)\.'
t_EQV       = r'\.(?i:EQV)\.'
t_NEQV      = r'\.(?i:NEQV)\.'
t_EQUALS    = r'='
t_COMMA     = r','
t_LPAREN    = r'\('
t_RPAREN    = r'\)'
t_COLON     = r':'

def t_newline(t):
    r'\n'
    t.lexer.lineno += 1

t_ignore = " \t"

def t_error(t):
    raise LexError(f"Invalid Symbol: {t.value[0]} at line {t.lexer.lineno}")

lexer = lex.lex()

def tokenize(data):
    data_truncated = '\n'.join(line[:72] for line in data.split('\n'))
    lexer.input(data_truncated)
    lexer.lineno = 1
    return lexer

def next_token():
    global _lookahead
    _lookahead = lexer.token()

def lookahead():
    return (_lookahead.type,_lookahead.value,_lookahead.lineno,_lookahead.lexpos) if _lookahead else ("$",None,None,None)
